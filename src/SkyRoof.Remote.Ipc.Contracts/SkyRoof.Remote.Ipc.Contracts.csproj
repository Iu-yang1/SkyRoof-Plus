<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.33.0" />
    <PackageReference Include="Grpc.Core.Api" Version="2.85.0" />
    <PackageReference Include="Grpc.Tools" Version="2.85.0" PrivateAssets="all" />
    <Protobuf Include="../../protocols/ipc/station_probe.proto" GrpcServices="Both" />
    <Protobuf Include="../../protocols/ipc/device_simulation.proto" GrpcServices="Both" />
    <Protobuf Include="../../protocols/ipc/device_control.proto" GrpcServices="Both" />
  </ItemGroup>
</Project>
