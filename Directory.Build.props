<Project>

  <!-- The single source of truth for the release version. Bump it here and nowhere else:
       MSBuild applies it to every project in the solution automatically, and the CI workflow
       patches the Inno Setup version during the Build and Release workflow. -->
  <!-- SkyRoof Plus v1.73: async satellite selection, group pass caches and responsive Orekit manual updates. -->
  <PropertyGroup>
    <Product>SkyRoof</Product>
    <!-- v1.73-maidenhead-skyview-replacement-20261113: guarded high-precision locator and UI repaint installer replacement. -->
    <Version>1.73</Version>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

</Project>
