<Project>

  <!-- The single source of truth for the release version. Bump it here and nowhere else:
       MSBuild applies it to every project in the solution automatically, and the CI workflow
       patches the Inno Setup version during the Build and Release workflow. -->
  <!-- SkyRoof Plus v1.75: Direct LAN audio resilience, CW Console V2, IF/AF telemetry and TX UDP diagnostics. -->
  <PropertyGroup>
    <Product>SkyRoof</Product>
    <!-- v1.75-lan-tx-cw-ifaf-20261114: normal versioned release, not an in-place replacement. -->
    <Version>1.75</Version>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

</Project>
