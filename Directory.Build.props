<Project>

  <!-- The single source of truth for the release version. Bump it here and nowhere else:
       MSBuild applies it to every project in the solution automatically, and the CI workflow
       patches the Inno Setup version during the Build and Release workflow. -->
  <!-- SkyRoof Plus v1.86: strict production-default UNNE-1B real-IQ/CFO/CRC acceptance. -->
  <PropertyGroup>
    <Product>SkyRoof</Product>
    <!-- v1.78-satellite-terminology-20261115: independent release; preserve v.1.77. -->
    <!-- v1.78-zh-toolbar-padding-replacement-20261115: user-authorized one-time rebuild of existing v.1.78. -->
    <!-- v1.86-unne-gear-square-buttons-replacement-20261118: user-authorized rebuild of this exact existing release. -->
    <!-- v1.87-continuous-waterfall-replacement-20261119: requested replacement of the exact existing v.1.87 installer for the user-tested continuous waterfall. -->
    <!-- v1.88-unne-catalog-link-20261123: independent release for official NORAD/telemetry identity reconciliation. -->
    <!-- v1.89-earth-context-menu-replacement-20261124: user-authorized one-time replacement of the exact v.1.89 installer, preserving existing Release metadata; retry with pole-safe inverse projection; supersede obsolete queued release. -->
    <Version>1.89</Version>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

</Project>
