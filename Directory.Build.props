<Project>

  <!-- The single source of truth for the release version. Bump it here and nowhere else:
       MSBuild applies it to every project in the solution automatically, and the CI workflow
       patches the Inno Setup version during the Build and Release workflow. -->
  <!-- SkyRoof Plus v1.77: ship zh-CN satellite resources and verify installed UI language resolution. -->
  <PropertyGroup>
    <Product>SkyRoof</Product>
    <!-- v1.77-zh-cn-installer-hotfix-20261115: independent release; preserve v.1.76. -->
    <Version>1.77</Version>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

</Project>
