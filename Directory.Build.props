<Project>

  <!-- The single source of truth for the release version. Bump it here and nowhere else:
       MSBuild applies it to every project in the solution automatically, and the CI workflow
       patches the Inno Setup version during the Build and Release workflow. -->
  <!-- SkyRoof Plus v1.81: prevent unconfirmed audio heartbeats from resetting TX sessions. -->
  <PropertyGroup>
    <Product>SkyRoof</Product>
    <!-- v1.78-satellite-terminology-20261115: independent release; preserve v.1.77. -->
    <!-- v1.78-zh-toolbar-padding-replacement-20261115: user-authorized one-time rebuild of existing v.1.78. -->
    <Version>1.81</Version>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

</Project>
