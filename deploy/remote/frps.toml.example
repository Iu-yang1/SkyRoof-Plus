# SkyRoof Remote V1 (reference only; do not commit production secrets)
bindAddr = "0.0.0.0"
bindPort = 7000
quicBindPort = 7000
proxyBindAddr = "0.0.0.0"

auth.method = "token"
auth.token = "REPLACE_WITH_PRIVATE_TOKEN"
transport.tls.force = true
transport.tls.certFile = "/etc/skyroof-frps/server.crt"
transport.tls.keyFile = "/etc/skyroof-frps/server.key"

allowPorts = [{ single = 18076 }, { single = 52000 }]
log.level = "warn"
webServer.addr = "127.0.0.1"
webServer.port = 0
