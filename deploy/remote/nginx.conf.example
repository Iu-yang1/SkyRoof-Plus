# Include inside nginx http {} and configure real certificate paths.
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}
server {
    listen 443 ssl;
    server_name station.example.com;
    ssl_certificate /etc/ssl/skyroof/fullchain.pem;
    ssl_certificate_key /etc/ssl/skyroof/privkey.pem;
    location / {
        proxy_pass http://127.0.0.1:18076;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600;
    }
}
